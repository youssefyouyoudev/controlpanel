APP_NAME=YouPanel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youpanel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
YOUPANEL_METRICS_DRIVER=auto
YOUPANEL_SERVICE_STATUS_DRIVER=auto
YOUPANEL_DEMO_ENABLED=false
YOUPANEL_PORTFOLIO_DEMO=false
FILE_MAX_EDIT_BYTES=524288
FILE_MAX_UPLOAD_BYTES=10485760
FILE_MAX_DOWNLOAD_BYTES=104857600
FILE_MAX_DIRECTORY_ITEMS=500
FILE_MAX_SEARCH_RESULTS=100
FILE_MAX_RECURSIVE_ITEMS=1000
FILE_MAX_RECURSIVE_BYTES=52428800
FILE_MAX_ARCHIVE_FILES=500
FILE_MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
FILE_MAX_ARCHIVE_RATIO=100
FILE_REVISION_MAX_BYTES=524288
FILE_REVISION_MAX_PER_FILE=25
FILE_REVISION_RETENTION_DAYS=30
TRASH_RETENTION_DAYS=30
YOUPANEL_ACTION_DRIVER=mock
ACTION_OUTPUT_MAX_BYTES=1048576
ACTION_OUTPUT_PREVIEW_BYTES=12000
ACTION_DEFAULT_TIMEOUT_SECONDS=120
ACTION_MAX_CONCURRENT_GLOBAL=3
ACTION_MAX_CONCURRENT_PER_WEBSITE=1
ACTION_SAFE_ENV_KEYS=HOME,PATH,COMPOSER_HOME,NPM_CONFIG_CACHE
LOG_INITIAL_LINES=200
LOG_MAX_LINES=500
LOG_STREAM_MAX_MINUTES=10
LOG_DOWNLOAD_MAX_BYTES=5242880
BACKUP_MAX_BYTES=262144000
BACKUP_MIN_FREE_DISK_BYTES=1073741824
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_DISK=local
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTH_CHECK_MAX_RESPONSE_BYTES=32768
HEALTH_CHECK_FAILURE_THRESHOLD=2
COOLIFY_ENABLED=false
COOLIFY_DRIVER=mock
COOLIFY_INTERNAL_URL=http://127.0.0.1:8000
COOLIFY_PUBLIC_URL=https://panel.youssefyouyou.com
COOLIFY_API_TOKEN=
COOLIFY_VERIFY_TLS=true
COOLIFY_TIMEOUT_SECONDS=15
COOLIFY_CONNECT_TIMEOUT_SECONDS=5
COOLIFY_CACHE_SECONDS=15
COOLIFY_MAX_RETRIES=2
COOLIFY_TERMINAL_ENABLED=false
COOLIFY_SYNC_INTERVAL_SECONDS=300
COOLIFY_STATUS_CACHE_SECONDS=15
COOLIFY_DEPLOYMENT_POLL_MIN_SECONDS=5
COOLIFY_DEPLOYMENT_POLL_MAX_SECONDS=60
COOLIFY_DEPLOYMENT_TIMEOUT_MINUTES=30
COOLIFY_MAX_CONCURRENT_DEPLOYMENTS=2
COOLIFY_LOG_MAX_BYTES=524288
COOLIFY_LOG_RETENTION_DAYS=14
CONSOLE_COMMAND_TIMEOUT_SECONDS=120
CONSOLE_OUTPUT_MAX_BYTES=262144
CONSOLE_MAX_CONCURRENT_PER_USER=1
CONTAINER_TERMINAL_IDLE_MINUTES=10
CONTAINER_TERMINAL_MAX_MINUTES=30

# Production cookie/session reference:
# APP_URL=https://control-api.youssefyouyou.com
# FRONTEND_URL=https://control.youssefyouyou.com
# SANCTUM_STATEFUL_DOMAINS=control.youssefyouyou.com
# SESSION_DOMAIN=.youssefyouyou.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# COOLIFY_ENABLED=true
# COOLIFY_DRIVER=api
# COOLIFY_API_TOKEN=never_commit_real_tokens
# YOUPANEL_PORTFOLIO_DEMO=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
